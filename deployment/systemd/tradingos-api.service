[Unit]
Description=TradingOS FastAPI Service
After=network.target

[Service]
Type=simple
User=tradingos
WorkingDirectory=/opt/tradingos/backend
EnvironmentFile=/etc/tradingos/tradingos.env
ExecStart=/opt/tradingos/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
